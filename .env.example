# Copy this file to .env and replace every placeholder before starting the project.
# Every value enclosed in angle brackets (<...>) is a placeholder only.
# These labels are not real configuration values, credentials, or personal data.
# In .env, replace each entire placeholder, including < and >, with your own value.
# Do not use the placeholder labels or angle brackets as literal values.
# .env is the single configuration file used by the app, database tools, and Docker.
# Do not set NODE_ENV or APP_ENV here; the project scripts select the environment.
COMPOSE_PROJECT_NAME=<compose_project_name>

# Local PostgreSQL settings shared with Docker Compose.
POSTGRES_IMAGE=<postgres_image>
POSTGRES_BIND_ADDRESS=<postgres_bind_address>
POSTGRES_HOST=<postgres_host>
POSTGRES_USER=<postgres_user>
# Required: choose a local database password.
POSTGRES_PASSWORD=<postgres_password>

# Separate development and test databases and volumes.
POSTGRES_DEV_DB=<postgres_dev_db>
POSTGRES_DEV_PORT=<postgres_dev_port>
POSTGRES_DEV_VOLUME=<postgres_dev_volume>
POSTGRES_TEST_DB=<postgres_test_db>
POSTGRES_TEST_PORT=<postgres_test_port>
POSTGRES_TEST_VOLUME=<postgres_test_volume>

# Public presentation settings. Dates use day/month/year and Guatemala time.
NEXT_PUBLIC_APP_NAME=<next_public_app_name>
NEXT_PUBLIC_LOCALE=<next_public_locale>
NEXT_PUBLIC_TIMEZONE=<next_public_timezone>
NEXT_PUBLIC_CURRENCY_SYMBOL=<next_public_currency_symbol>

# Authentication and password generation.
BETTER_AUTH_URL=<better_auth_url>
# Required: generate a cryptographically random secret of at least 32 characters.
BETTER_AUTH_SECRET=<better_auth_secret>
INITIAL_PASSWORD_CHARSET=<initial_password_charset>
# Must be an integer between 8 and 128.
INITIAL_PASSWORD_LENGTH=<initial_password_length>

# Initial development administrator created by db:seed.
SUPERADMIN_NAME=<superadmin_name>
SUPERADMIN_EMAIL=<superadmin_email>
# Required: choose a strong administrator password (at least 8 characters).
SUPERADMIN_PASSWORD=<superadmin_password>
